#!/bin/zsh

emulate -L zsh
setopt localoptions pipefail extendedglob

PROGRAM_NAME="spititout"
INSTALL_DIR="${HOME}/.local/bin"
INSTALL_PATH="${INSTALL_DIR}/${PROGRAM_NAME}"
VERSION="1.0.0"

ACCENT=$'\033[38;2;129;162;190m'
DIM=$'\033[2m'
RESET=$'\033[0m'

typeset -a FORMULAE
typeset -a EXPLICIT_FORMULAE
typeset -a CASKS
typeset -a APPS

BREW_AVAILABLE=0

if command -v brew >/dev/null 2>&1; then
    BREW_AVAILABLE=1
fi

usage() {
    cat <<EOF
SPITITOUT ${VERSION}

Tiny local macOS inventory.

Usage:
  spititout
  spititout --help
  spititout --json
  spititout zap

Options:
  --help    Show this help.
  --json    Output the inventory as JSON.
  zap       Remove the installed SPITITOUT executable.

EOF
}

die() {
    print -u2 -P "${ACCENT}error:${RESET} $*"
    exit 1
}

is_apple_app() {
    local app="$1"
    local name="${app:t:r}"
    local bundle_id

    # Never scan Apple's system application locations.
    case "$app" in
        /System/Applications/*|/System/Library/*)
            return 0
            ;;
    esac

    # Known Apple applications that may live in /Applications.
    case "$name" in
        App\ Store|Automator|Books|Calculator|Calendar|Chess|Clock|\
        Contacts|Dictionary|FaceTime|Find\ My|Font\ Book|Freeform|\
        Home|Image\ Capture|Keynote|Mail|Maps|Messages|Mission\ Control|\
       Music|News|Notes|Photo\ Booth|Photos|Podcasts|Preview|QuickTime\ Player|\
       Reminders|Safari|Shortcuts|Siri|Stickies|Stocks|System\ Settings|\
       TextEdit|Time\ Machine|TV|Voice\ Memos)
            return 0
            ;;
    esac

    bundle_id=$(mdls -raw -name kMDItemCFBundleIdentifier "$app" 2>/dev/null)

    if [[ "$bundle_id" == com.apple.* ]]; then
        return 0
    fi

    return 1
}

collect_brew() {
    FORMULAE=()
    EXPLICIT_FORMULAE=()
    CASKS=()

    (( BREW_AVAILABLE == 0 )) && return

    while IFS= read -r line; do
        [[ -n "$line" ]] && FORMULAE+=("$line")
    done < <(brew list --formula 2>/dev/null | sort -fu)

    while IFS= read -r line; do
        [[ -n "$line" ]] && EXPLICIT_FORMULAE+=("$line")
    done < <(brew leaves 2>/dev/null | sort -fu)

    while IFS= read -r line; do
        [[ -n "$line" ]] && CASKS+=("$line")
    done < <(brew list --cask 2>/dev/null | sort -fu)
}

collect_apps() {
    APPS=()

    local -a candidates
    candidates=()

    if [[ -d /Applications ]]; then
        candidates+=(/Applications/*.app(N))
    fi

    if [[ -d "${HOME}/Applications" ]]; then
        candidates+=("${HOME}/Applications"/*.app(N))
    fi

    local app

    for app in "${candidates[@]}"; do
        [[ -d "$app" ]] || continue

        is_apple_app "$app" && continue

        APPS+=("$app")
    done

    APPS=("${(@ou)APPS}")
}

print_header() {
    print
    print -P "${ACCENT}                 SPITITOUT by willow${RESET}"
    print -P "${DIM}────────────────────────────────────────────────────────────${RESET}"
    print -P "system inventory ${DIM}• read-only • local only${RESET}"
    print
}

print_system() {
    local os
    local kernel
    local arch
    local shell_name
    local brew_version

    os=$(sw_vers -productVersion 2>/dev/null || print "unknown")
    kernel=$(uname -r 2>/dev/null || print "unknown")
    arch=$(uname -m 2>/dev/null || print "unknown")
    shell_name="${SHELL:t}"

    if (( BREW_AVAILABLE )); then
        brew_version=$(brew --version 2>/dev/null | head -n 1)
    else
        brew_version="not installed"
    fi

    print -P "${ACCENT}SYSTEM${RESET}"
    print "  macOS        ${os}"
    print "  kernel       ${kernel}"
    print "  architecture ${arch}"
    print "  shell        ${shell_name}"
    print "  Homebrew     ${brew_version}"
    print
}

print_formulae() {
    print -P "${ACCENT}FORMULAE${RESET} ${DIM}(${#FORMULAE[@]})${RESET}"

    if (( ${#FORMULAE[@]} == 0 )); then
        print -P "  ${DIM}none${RESET}"
        print
        return
    fi

    local formula
    local explicit
    local marker

    for formula in "${FORMULAE[@]}"; do
        marker=""

        for explicit in "${EXPLICIT_FORMULAE[@]}"; do
            if [[ "$formula" == "$explicit" ]]; then
                marker=" ${ACCENT}•${RESET}"
                break
            fi
        done

        print -P "  ${formula}${marker}"
    done

    print
    print -P "${DIM}• explicit install${RESET}"
    print
}

print_casks() {
    print -P "${ACCENT}CASKS${RESET} ${DIM}(${#CASKS[@]})${RESET}"

    if (( ${#CASKS[@]} == 0 )); then
        print -P "  ${DIM}none${RESET}"
        print
        return
    fi

    local cask

    for cask in "${CASKS[@]}"; do
        print -- "  ${cask}"
    done

    print
}

print_apps() {
    print -P "${ACCENT}APPLICATIONS${RESET} ${DIM}(${#APPS[@]})${RESET}"

    if (( ${#APPS[@]} == 0 )); then
        print -P "  ${DIM}none${RESET}"
        print
        return
    fi

    local app
    local name

    for app in "${APPS[@]}"; do
        name="${app:t:r}"
        print -- "  ${name}"
    done

    print
}

print_totals() {
    print -P "${ACCENT}TOTALS${RESET}"
    print "  formulae       ${#FORMULAE[@]}"
    print "  explicit       ${#EXPLICIT_FORMULAE[@]}"
    print "  casks          ${#CASKS[@]}"
    print "  applications   ${#APPS[@]}"
    print
}

json_escape() {
    local value="$1"

    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}

    print -r -- "$value"
}

json_array() {
    local -a values=("${(@)@}")
    local value
    local first=1

    print -n "["

    for value in "${values[@]}"; do
        (( first == 0 )) && print -n ","
        first=0
        print -n "\"$(json_escape "$value")\""
    done

    print "]"
}

print_json() {
    local os
    local kernel
    local arch
    local shell_name
    local brew_version

    os=$(sw_vers -productVersion 2>/dev/null || print "unknown")
    kernel=$(uname -r 2>/dev/null || print "unknown")
    arch=$(uname -m 2>/dev/null || print "unknown")
    shell_name="${SHELL:t}"

    if (( BREW_AVAILABLE )); then
        brew_version=$(brew --version 2>/dev/null | head -n 1)
    else
        brew_version="not installed"
    fi

    print "{"
    print "  \"program\": \"${PROGRAM_NAME}\","
    print "  \"version\": \"${VERSION}\","
    print "  \"system\": {"
    print "    \"macos\": \"$(json_escape "$os")\","
    print "    \"kernel\": \"$(json_escape "$kernel")\","
    print "    \"architecture\": \"$(json_escape "$arch")\","
    print "    \"shell\": \"$(json_escape "$shell_name")\","
    print "    \"homebrew\": \"$(json_escape "$brew_version")\""
    print "  },"
    print "  \"homebrew\": {"
    print "    \"formulae\": $(json_array "${FORMULAE[@]}"),"
    print "    \"explicit_formulae\": $(json_array "${EXPLICIT_FORMULAE[@]}"),"
    print "    \"casks\": $(json_array "${CASKS[@]}")"
    print "  },"
    print "  \"applications\": $(json_array "${(@)APPS:t:r}")"
    print "}"
}

zap() {
    if [[ ! -e "$INSTALL_PATH" ]]; then
        print -P "${ACCENT}${PROGRAM_NAME}${RESET} is not installed at:"
        print "  ${INSTALL_PATH}"
        return 0
    fi

    rm -f -- "$INSTALL_PATH" || die "could not remove ${INSTALL_PATH}"

    print -P "${ACCENT}SPITITOUT${RESET} removed."
    print -P "${DIM}Only the installed executable was removed.${RESET}"
}

main() {
    case "${1:-}" in
        --help|-h)
            usage
            return 0
            ;;

        --json)
            collect_brew
            collect_apps
            print_json
            return 0
            ;;

        zap)
            zap
            return 0
            ;;

        "")
            ;;

        *)
            print -u2 "Unknown option: $1"
            print -u2
            usage
            return 1
            ;;
    esac

    collect_brew
    collect_apps

    print_header
    print_system
    print_formulae
    print_casks
    print_apps
    print_totals

    print -P "${DIM}read-only • local-only • no telemetry${RESET}"
    print
}

main "$@"
